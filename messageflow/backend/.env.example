# Example environment variables - copy to .env and set secure values
POSTGRES_USER=messageflow
POSTGRES_PASSWORD=messageflow
POSTGRES_DB=messageflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://messageflow:messageflow@postgres:5432/messageflow

REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace-this-with-a-VERY-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp_user
SMTP_PASSWORD=smtp_pass
EMAIL_FROM=no-reply@messageflow.app

WHATSAPP_API_BASE=https://graph.facebook.com/v16.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ID=your_business_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

APP_HOST=0.0.0.0
APP_PORT=8000
